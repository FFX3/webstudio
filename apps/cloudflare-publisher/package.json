{
  "name": "@webstudio-is/cloudflare-publisher",
  "version": "0.0.0",
  "private": true,
  "description": "Cloudflare Pages deployment service for Webstudio",
  "type": "module",
  "scripts": {
    "build": "rm -rf dist && esbuild src/index.ts --outfile=dist/index.cjs --bundle --format=cjs --platform=node --conditions=webstudio --external:pg --external:zod",
    "dev": "tsx watch --conditions=webstudio src/index.ts",
    "start": "node dist/index.cjs",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@trpc/server": "^10.45.2",
    "@webstudio-is/http-client": "workspace:*",
    "@webstudio-is/trpc-interface": "workspace:*",
    "express": "^4.21.0",
    "pg": "^8.13.1",
    "wrangler": "^3.63.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@types/express": "^4.17.21",
    "@types/node": "^22.10.0",
    "@types/pg": "^8.11.10",
    "@webstudio-is/tsconfig": "workspace:*",
    "esbuild": "^0.25.3",
    "tsx": "^4.19.2",
    "typescript": "7.0.2"
  },
  "engines": {
    "node": ">=22.12.0"
  },
  "license": "AGPL-3.0-or-later"
}
